{
  "schema": 1,
  "id": "baseline-transparent",
  "title": "Baseline Transparent",
  "description": "Use the Baseline theme with window translucency and the matching main-pane snippet.",
  "platforms": [
    "darwin"
  ],
  "set": {
    "appearance": {
      "cssTheme": {
        "set": "Baseline"
      },
      "translucency": {
        "set": true
      },
      "enabledCssSnippets": {
        "add": [
          "baseline-transparent-main"
        ]
      }
    }
  }
}
