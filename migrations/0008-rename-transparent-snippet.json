{
  "schema": 1,
  "id": "0008-rename-transparent-snippet",
  "description": "Rename the enabled snippet baseline-transparent-main to terminal-transparent: the snippet file has the new name, and it works with every theme. No operation renames a list member, so each operation checks one position of the list (the first 20) and changes it only when it holds the old name. A list without the old name does not change.",
  "file": "appearance.json",
  "platforms": [
    "darwin",
    "linux"
  ],
  "operations": [
    {
      "op": "set-if-equals",
      "key": "/enabledCssSnippets/0",
      "from": "baseline-transparent-main",
      "to": "terminal-transparent"
    },
    {
