{
  "id": "baseline-transparent",
  "title": "Baseline Transparent",
  "description": "Use the Baseline theme with Obsidian window translucency and the matching main-pane transparency snippet.",
  "apply": [
    {
      "target": "appearance.json",
      "type": "json-set",
      "changes": [
        { "path": ["cssTheme"], "value": "Baseline" },
        { "path": ["translucency"], "value": true },
        { "path": ["enabledCssSnippets"], "mode": "merge", "value": ["baseline-transparent-main"] }
      ]
    }
  ]
}
